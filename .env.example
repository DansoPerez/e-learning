# Copy to .env and fill in real values (never commit .env)

# Supabase PostgreSQL — Project Settings → Database → Connection string (URI)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Auth.js
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email — registration OTP, password reset, admin alerts
# Prefer Gmail SMTP (no custom domain). If SMTP_* is set it is used instead of Resend.
#
# Gmail setup:
# 1. Google Account → Security → turn on 2-Step Verification
# 2. Security → App passwords → create one for "Mail"
# 3. Paste the 16-character password into SMTP_PASS (no spaces)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="youraccount@gmail.com"
SMTP_PASS=""
# Optional — defaults to SMTP_USER. Must be your Gmail address when using free Gmail.
# SMTP_FROM="youraccount@gmail.com"
# SMTP_FROM_NAME="Bravio"
# EMAIL_TEST_TO="you@example.com"
#
# Optional alternative: Resend (used only when SMTP_* is not set)
# RESEND_API_KEY=""
# RESEND_FROM_EMAIL="onboarding@resend.dev"
# RESEND_FROM_NAME="Bravio"
#
EMAIL_VERIFICATION_ENABLED="true"
# Personal inbox for admin alerts: new students, instructor applications, withdrawals
# ADMIN_NOTIFICATION_EMAIL="you@gmail.com"
# Welcome offer after a successful purchase (applied at next checkout + shown in email)
# WELCOME_DISCOUNT_PERCENT="15"
# WELCOME_DISCOUNT_DAYS="30"

# Paystack — paid course enrollment (auto-enabled when PAYSTACK_SECRET_KEY is set)
# Test keys: https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=""
PAYSTACK_CURRENCY="GHS"
# Set to "false" to keep free enrollment even when a key is present (e.g. staging)
# PAYMENTS_ENABLED="false"
# Set to "false" to disable Paystack instructor payouts (manual payouts only)
# PAYSTACK_PAYOUTS_ENABLED="false"

# Cloudinary (optional)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
